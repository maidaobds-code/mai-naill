{
  "name": "nail-japan-mvp",
  "version": "0.1.10",
  "description": "Mainaill desktop booking synchronization manager",
  "author": "Mainaill",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "test:booking-sync": "node artifacts/booking-qa/shared-sync-check.mjs",
    "test:external-sync": "node artifacts/booking-qa/external-sync-check.mjs",
    "test:salon-capacity": "node artifacts/booking-qa/salon-capacity-check.mjs",
    "test:automation-config": "node artifacts/booking-qa/automation-config-check.mjs",
    "test:task-guard": "node artifacts/booking-qa/task-guard-check.mjs",
    "test:expired-capacity": "node artifacts/booking-qa/expired-capacity-task-check.mjs",
    "test:refactor-safety": "node artifacts/booking-qa/refactor-safety-check.mjs",
    "test:windows-autostart": "node artifacts/booking-qa/windows-autostart-check.mjs",
    "test:staff-sync": "node artifacts/booking-qa/staff-sync-check.mjs",
    "test:timeline-alignment": "node artifacts/booking-qa/timeline-alignment-check.mjs",
    "test:mobile-calendar": "node artifacts/booking-qa/mobile-calendar-check.mjs",
    "test:staff-closure": "node artifacts/booking-qa/staff-closure-booking-check.mjs",
    "test:hot-closed-sync": "node artifacts/booking-qa/hot-closed-sync-check.mjs",
    "test:owner-closed-staff": "node artifacts/booking-qa/owner-closed-staff-action-check.mjs",
    "test:gmail-staff-button": "node artifacts/booking-qa/gmail-staff-button-check.mjs",
    "test:owner-approval-email": "node artifacts/booking-qa/owner-approval-customer-email-check.mjs",
    "test:customer-email-language": "node artifacts/booking-qa/customer-email-language-check.mjs",
    "automation:salonboard": "node automation/salonboard-worker.mjs",
    "automation:nailie": "node automation/nailie-worker.mjs",
    "desktop": "electron .",
    "package:windows": "electron-builder --win nsis",
    "start": "next start"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "star-io10-web": "^1.0.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "babel-loader": "^10.1.1",
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mainaill.bot",
    "productName": "Mainaill Bot",
    "asar": true,
    "files": ["electron/**/*", "automation/**/*", "lib/salonboardNames.mjs", "lib/syncTaskExpiry.js", "package.json", "node_modules/**/*"],
    "directories": { "output": "dist" },
    "extraResources": [{ "from": "vendor/playwright-browsers", "to": "playwright-browsers" }],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mainaill Bot"
    },
    "win": { "target": ["nsis"], "artifactName": "Mainaill-Bot-Setup-${version}.${ext}" }
  }
}
